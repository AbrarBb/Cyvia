<?xml version="1.0" encoding="utf-8"?>
<!-- Calendar day background: lighter oval for predicted period days -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="@color/calendar_predicted" />
    <stroke
        android:width="1.5dp"
        android:color="@color/cyvia_primary"
        android:dashWidth="3dp"
        android:dashGap="2dp" />
</shape>

<?xml version="1.0" encoding="utf-8"?>
<!--
    Data extraction rules for Android 12+ (API 31+).
    We explicitly exclude all app data from cloud backup to honor our privacy promise.
    Users who want backup must use the in-app JSON export feature.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude everything — no data leaves the device through Android's cloud backup -->
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <!-- Allow local device-to-device transfers (same user, different device) -->
        <include domain="file" path="." />
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>

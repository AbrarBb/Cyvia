<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/cyvia_background">

    <!-- Month navigation header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/space_8"
        android:paddingEnd="@dimen/space_8"
        android:paddingTop="@dimen/space_16"
        android:paddingBottom="@dimen/space_12">

        <ImageButton
            android:id="@+id/btn_prev_month"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_media_previous"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_calendar_prev"
            android:tint="@color/cyvia_primary" />

        <TextView
            android:id="@+id/tv_month_year"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="July 2026"
            android:textSize="@dimen/text_title_large"
            android:fontFamily="@font/nunito"
            android:textStyle="bold"
            android:textColor="@color/cyvia_on_background" />

        <ImageButton
            android:id="@+id/btn_next_month"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_media_next"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_calendar_next"
            android:tint="@color/cyvia_primary" />
    </LinearLayout>

    <!-- Day of week headers (Su, Mo, Tu, ...) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_4"
        android:paddingEnd="@dimen/space_4"
        android:paddingBottom="@dimen/space_8">

        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Su" android:gravity="center" android:textSize="@dimen/text_label_small" android:textColor="@color/cyvia_on_surface_variant" android:fontFamily="@font/inter" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Mo" android:gravity="center" android:textSize="@dimen/text_label_small" android:textColor="@color/cyvia_on_surface_variant" android:fontFamily="@font/inter" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Tu" android:gravity="center" android:textSize="@dimen/text_label_small" android:textColor="@color/cyvia_on_surface_variant" android:fontFamily="@font/inter" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="We" android:gravity="center" android:textSize="@dimen/text_label_small" android:textColor="@color/cyvia_on_surface_variant" android:fontFamily="@font/inter" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Th" android:gravity="center" android:textSize="@dimen/text_label_small" android:textColor="@color/cyvia_on_surface_variant" android:fontFamily="@font/inter" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Fr" android:gravity="center" android:textSize="@dimen/text_label_small" android:textColor="@color/cyvia_on_surface_variant" android:fontFamily="@font/inter" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Sa" android:gravity="center" android:textSize="@dimen/text_label_small" android:textColor="@color/cyvia_on_surface_variant" android:fontFamily="@font/inter" />
    </LinearLayout>

    <!-- Calendar grid -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_calendar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/space_4"
        android:paddingEnd="@dimen/space_4"
        android:clipToPadding="false" />

    <!-- Calendar legend -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingStart="@dimen/screen_padding_horizontal"
        android:paddingEnd="@dimen/screen_padding_horizontal"
        android:paddingTop="@dimen/space_12"
        android:paddingBottom="@dimen/space_8">

        <!-- Period -->
        <View android:layout_width="10dp" android:layout_height="10dp" android:background="@drawable/bg_calendar_period" android:layout_marginEnd="@dimen/space_4" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Period" android:textSize="@dimen/text_caption" android:fontFamily="@font/inter" android:textColor="@color/cyvia_on_surface_variant" android:layout_marginEnd="@dimen/space_12" />

        <!-- Predicted -->
        <View android:layout_width="10dp" android:layout_height="10dp" android:background="@drawable/bg_calendar_predicted" android:layout_marginEnd="@dimen/space_4" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Predicted" android:textSize="@dimen/text_caption" android:fontFamily="@font/inter" android:textColor="@color/cyvia_on_surface_variant" android:layout_marginEnd="@dimen/space_12" />

        <!-- Fertile -->
        <View android:layout_width="10dp" android:layout_height="10dp" android:background="@drawable/bg_calendar_fertile" android:layout_marginEnd="@dimen/space_4" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Fertile" android:textSize="@dimen/text_caption" android:fontFamily="@font/inter" android:textColor="@color/cyvia_on_surface_variant" android:layout_marginEnd="@dimen/space_12" />

        <!-- Ovulation -->
        <View android:layout_width="10dp" android:layout_height="10dp" android:background="@drawable/bg_calendar_ovulation" android:layout_marginEnd="@dimen/space_4" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Ovulation" android:textSize="@dimen/text_caption" android:fontFamily="@font/inter" android:textColor="@color/cyvia_on_surface_variant" />
    </LinearLayout>

    <!-- Divider -->
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" android:layout_marginStart="@dimen/screen_padding_horizontal" android:layout_marginEnd="@dimen/screen_padding_horizontal" />

    <!-- ── Period Confirmation Banner ── shown when period is active/overdue ── -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_period_confirm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_padding_horizontal"
        android:layout_marginEnd="@dimen/screen_padding_horizontal"
        android:layout_marginTop="@dimen/space_8"
        android:layout_marginBottom="@dimen/space_4"
        android:visibility="gone"
        app:cardCornerRadius="18dp"
        app:cardElevation="0dp"
        app:strokeWidth="1.5dp"
        app:strokeColor="@color/cyvia_primary"
        app:cardBackgroundColor="@color/cyvia_primary_container">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="12dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_phase_menstrual"
                app:tint="@color/cyvia_primary"
                android:layout_marginEnd="12dp"
                android:contentDescription="Period" />

            <TextView
                android:id="@+id/tv_period_confirm_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Period Ends"
                android:textSize="14sp"
                android:fontFamily="@font/nunito"
                android:textStyle="bold"
                android:textColor="@color/cyvia_on_primary_container" />

            <!-- Yes button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_period_yes"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Yes"
                android:textSize="13sp"
                android:layout_marginEnd="6dp"
                app:cornerRadius="20dp"
                android:backgroundTint="@color/cyvia_surface"
                android:textColor="@color/cyvia_on_background" />

            <!-- No button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_period_no"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No"
                android:textSize="13sp"
                app:cornerRadius="20dp"
                android:backgroundTint="@color/cyvia_primary"
                android:textColor="@color/cyvia_on_primary" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Selected day detail area & Mochi Cheering Hub (Fills middle space) -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding_horizontal"
            android:paddingEnd="@dimen/screen_padding_horizontal"
            android:paddingTop="@dimen/space_8"
            android:paddingBottom="@dimen/space_16">

            <LinearLayout
                android:id="@+id/layout_day_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="@dimen/space_12"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tv_selected_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/text_title_medium"
                    android:fontFamily="@font/nunito"
                    android:textStyle="bold"
                    android:textColor="@color/cyvia_on_background"
                    android:layout_marginBottom="@dimen/space_8" />

                <TextView
                    android:id="@+id/tv_day_summary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/text_body_medium"
                    android:fontFamily="@font/inter"
                    android:textColor="@color/cyvia_on_surface_variant"
                    android:layout_marginBottom="@dimen/space_12" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_log_selected_day"
                    style="@style/Widget.Cyvia.Button.Outlined"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Log this day" />
            </LinearLayout>

            <!-- Funny Mochi Cheering & Support Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_mochi_support"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="8dp"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp"
                app:strokeWidth="1.5dp"
                app:strokeColor="@color/cyvia_peach"
                app:cardBackgroundColor="@color/cyvia_primary_container">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp">

                    <ImageView
                        android:id="@+id/img_calendar_mochi"
                        android:layout_width="84dp"
                        android:layout_height="84dp"
                        android:src="@drawable/ic_mochi_celebrating"
                        android:contentDescription="Mochi Cat Support" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="14dp">

                        <TextView
                            android:id="@+id/tv_mochi_support_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Mochi's Daily Cheer! 🎉"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/nunito"
                            android:textColor="@color/cyvia_on_primary_container" />

                        <TextView
                            android:id="@+id/tv_mochi_support_message"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="You are doing amazing today! Tap Mochi anytime for positive cheering and self-care tips ~ ✨"
                            android:textSize="13sp"
                            android:lineSpacingExtra="2dp"
                            android:fontFamily="@font/inter"
                            android:textColor="@color/cyvia_on_surface" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Sex Life Prediction Card (Beta) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_sex_life_prediction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="8dp"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp"
                app:strokeWidth="1.5dp"
                app:strokeColor="@color/cyvia_outline"
                app:cardBackgroundColor="@color/cyvia_surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sex Life Prediction 🌸"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/nunito"
                        android:textColor="@color/cyvia_on_background" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="*Predictions based on cycle and pregnancy probability data"
                        android:textSize="11sp"
                        android:fontFamily="@font/inter"
                        android:textColor="@color/cyvia_on_surface_variant"
                        android:layout_marginBottom="12dp" />

                    <!-- Row 1: No Sex -->
                    <LinearLayout
                        android:id="@+id/row_pred_nope"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="10dp"
                        android:visibility="gone">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_sex_nope"
                            android:layout_marginEnd="12dp"
                            android:contentDescription="No sex" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="No Sex (Period days)"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:fontFamily="@font/nunito"
                                android:textColor="@color/cyvia_on_background" />

                            <TextView
                                android:id="@+id/tv_pred_nope_dates"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="—"
                                android:textSize="12sp"
                                android:fontFamily="@font/inter"
                                android:textColor="@color/cyvia_on_surface_variant" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Row 2: Protected Sex -->
                    <LinearLayout
                        android:id="@+id/row_pred_protected"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="10dp"
                        android:visibility="gone">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_sex_protected"
                            android:layout_marginEnd="12dp"
                            android:contentDescription="Protected sex" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tv_pred_protected_title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Protected Sex (High pregnancy chance)"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:fontFamily="@font/nunito"
                                android:textColor="@color/cyvia_on_background" />

                            <TextView
                                android:id="@+id/tv_pred_protected_dates"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="—"
                                android:textSize="12sp"
                                android:fontFamily="@font/inter"
                                android:textColor="@color/cyvia_on_surface_variant" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Row 3: Unprotected Sex -->
                    <LinearLayout
                        android:id="@+id/row_pred_unprotected"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:visibility="gone">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_sex_unprotected"
                            android:layout_marginEnd="12dp"
                            android:contentDescription="Unprotected sex" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tv_pred_unprotected_title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Unprotected Sex (Low pregnancy chance)"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:fontFamily="@font/nunito"
                                android:textColor="@color/cyvia_on_background" />

                            <TextView
                                android:id="@+id/tv_pred_unprotected_dates"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="—"
                                android:textSize="12sp"
                                android:fontFamily="@font/inter"
                                android:textColor="@color/cyvia_on_surface_variant" />
                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- AdMob banner at bottom (Calendar screen) -->
    <FrameLayout
        android:id="@+id/ad_banner_container"
        android:layout_width="match_parent"
        android:layout_height="@dimen/ad_banner_height" />

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/cyvia_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding_horizontal"
        android:paddingEnd="@dimen/screen_padding_horizontal"
        android:paddingTop="@dimen/space_48"
        android:paddingBottom="@dimen/space_32">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/onboarding_last_period_title"
            android:textSize="@dimen/text_headline_medium"
            android:fontFamily="@font/nunito"
            android:textStyle="bold"
            android:textColor="@color/cyvia_on_background"
            android:gravity="center"
            android:layout_marginBottom="@dimen/space_12" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/onboarding_last_period_subtitle"
            android:textSize="@dimen/text_body_large"
            android:fontFamily="@font/inter"
            android:textColor="@color/cyvia_on_surface_variant"
            android:gravity="center"
            android:lineSpacingMultiplier="1.4"
            android:layout_marginBottom="@dimen/space_40" />

        <!-- Date picker button -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_date_picker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="@dimen/corner_large"
            app:cardElevation="2dp"
            android:backgroundTint="@color/cyvia_surface"
            android:layout_marginBottom="@dimen/space_16">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="@dimen/space_20">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🌸  Last period start"
                    android:textSize="@dimen/text_body_large"
                    android:fontFamily="@font/inter"
                    android:textColor="@color/cyvia_on_surface_variant" />

                <TextView
                    android:id="@+id/tv_selected_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/onboarding_last_period_hint"
                    android:textSize="@dimen/text_body_large"
                    android:fontFamily="@font/nunito"
                    android:textStyle="bold"
                    android:textColor="@color/cyvia_primary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- "I'm not sure" text button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_skip_date"
            style="@style/Widget.Cyvia.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="@string/onboarding_skip_date"
            android:textColor="@color/cyvia_on_surface_variant" />

    </LinearLayout>
</ScrollView>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="86dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal|top"
    android:baselineAligned="false"
    android:padding="@dimen/space_4">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_kawaii_badge"
        android:layout_width="54dp"
        android:layout_height="54dp"
        app:cardCornerRadius="27dp"
        app:cardElevation="0dp"
        app:strokeWidth="1.5dp"
        app:strokeColor="@color/cyvia_outline"
        android:layout_marginBottom="@dimen/space_4">

        <ImageView
            android:id="@+id/iv_kawaii_icon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="Kawaii Badge Icon" />
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/tv_kawaii_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="11sp"
        android:fontFamily="@font/nunito"
        android:textStyle="bold"
        android:gravity="center"
        android:maxLines="3"
        android:ellipsize="end"
        android:textColor="@color/cyvia_on_surface" />
</LinearLayout>

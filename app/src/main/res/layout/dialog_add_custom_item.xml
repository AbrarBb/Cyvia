<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/space_24"
    android:background="@drawable/bg_dialog_rounded">

    <TextView
        android:id="@+id/tv_dialog_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Create Custom Item"
        android:textSize="20sp"
        android:fontFamily="@font/nunito"
        android:textStyle="bold"
        android:textColor="@color/cyvia_on_surface"
        android:layout_marginBottom="@dimen/space_16" />

    <!-- Type selector (if applicable) -->
    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/toggle_custom_type"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:singleSelection="true"
        app:selectionRequired="true"
        android:layout_marginBottom="@dimen/space_16">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_type_symptom"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Symptom" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_type_mood"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Mood" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <!-- Label input -->
    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Name (e.g. Sugar Cravings, Cozy)"
        android:layout_marginBottom="@dimen/space_16">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_custom_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapWords"
            android:fontFamily="@font/nunito" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Choose Icon or Upload Image:"
        android:textSize="14sp"
        android:fontFamily="@font/nunito"
        android:textStyle="bold"
        android:textColor="@color/cyvia_on_surface"
        android:layout_marginBottom="@dimen/space_8" />

    <!-- Upload custom image button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_upload_image"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:icon="@android:drawable/ic_menu_gallery"
        android:text="Upload Image from Gallery"
        android:layout_marginBottom="@dimen/space_12" />

    <!-- Selected custom image preview badge -->
    <LinearLayout
        android:id="@+id/layout_uploaded_preview"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="@dimen/space_12"
        android:visibility="gone">

        <ImageView
            android:id="@+id/iv_uploaded_preview"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="@dimen/space_8" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Custom Photo Selected!"
            android:textColor="@color/cyvia_success"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Or select preset Kawaii character:"
        android:textSize="12sp"
        android:textColor="@color/cyvia_on_surface_variant"
        android:layout_marginBottom="@dimen/space_8" />

    <!-- Horizontal scroll picker for preset Kawaii icons -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginBottom="@dimen/space_24">

        <LinearLayout
            android:id="@+id/layout_preset_icons"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <!-- Save / Cancel buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_cancel_custom"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cancel"
            android:layout_marginEnd="@dimen/space_8" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_save_custom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Save Item" />
    </LinearLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/cyvia_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding_horizontal"
        android:paddingEnd="@dimen/screen_padding_horizontal"
        android:paddingTop="@dimen/space_48"
        android:paddingBottom="@dimen/space_32">

        <!-- Lock icon / illustration -->
        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:src="@drawable/ic_lock"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="@dimen/space_24"
            android:contentDescription="Privacy Lock" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/onboarding_privacy_title"
            android:textSize="@dimen/text_headline_medium"
            android:fontFamily="@font/nunito"
            android:textStyle="bold"
            android:textColor="@color/cyvia_on_background"
            android:gravity="center"
            android:layout_marginBottom="@dimen/space_16" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/onboarding_privacy_subtitle"
            android:textSize="@dimen/text_body_large"
            android:fontFamily="@font/inter"
            android:textColor="@color/cyvia_on_surface_variant"
            android:gravity="center"
            android:lineSpacingMultiplier="1.5"
            android:layout_marginBottom="@dimen/space_32" />

        <!-- Privacy points -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="@dimen/corner_large"
            app:cardElevation="2dp"
            android:backgroundTint="@color/cyvia_surface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_24">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/space_12"
                    android:fontFamily="@font/inter"
                    android:text="@string/onboarding_privacy_point1"
                    android:textColor="@color/cyvia_on_background"
                    android:textSize="@dimen/text_body_large" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/space_12"
                    android:fontFamily="@font/inter"
                    android:text="@string/onboarding_privacy_point2"
                    android:textColor="@color/cyvia_on_background"
                    android:textSize="@dimen/text_body_large" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter"
                    android:text="@string/onboarding_privacy_point3"
                    android:textColor="@color/cyvia_on_background"
                    android:textSize="@dimen/text_body_large" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            app:cardCornerRadius="@dimen/corner_large"
            app:cardElevation="2dp"
            android:backgroundTint="@color/cyvia_surface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_20">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Safe &amp; Tailored Experience"
                    android:textSize="@dimen/text_title_medium"
                    android:fontFamily="@font/nunito"
                    android:textStyle="bold"
                    android:textColor="@color/cyvia_primary"
                    android:layout_marginBottom="@dimen/space_12" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_onboarding_minor_safe"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Teen / Minor Safe Mode"
                    android:fontFamily="@font/inter"
                    android:textColor="@color/cyvia_on_background" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Hides pregnancy chance percentages and sexual intimacy tracking fields."
                    android:textSize="@dimen/text_caption"
                    android:fontFamily="@font/inter"
                    android:textColor="@color/cyvia_on_surface_variant" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
